# AIDLC Platform — environment template.
# Copy to `.env` (gitignored) and fill in. NEVER commit real secrets; NEVER paste keys into chat.
# Grouped by what the M0 thin-slice (Dev/Fix path, mock sandbox, submit-via-API) actually needs.

# ─────────────────────────────────────────────────────────────────────────────
# 1) MODEL  — pick ONE provider for M0 (see IMPLEMENTATION-PLAN.md §6)
# ─────────────────────────────────────────────────────────────────────────────
# CHOSEN — DeepSeek via the OpenAI-compatible adapter (cheap; strong coder for Dev/Test).
#   Create the key at platform.deepseek.com, then fill AIDLC_OPENAI_COMPAT_API_KEY.
AIDLC_OPENAI_COMPAT_BASE_URL=https://api.deepseek.com/v1
AIDLC_OPENAI_COMPAT_MODEL=deepseek-v4-pro   # current lineup: deepseek-v4-pro (strong coder) | deepseek-flash (cheap/fast)
AIDLC_OPENAI_COMPAT_API_KEY=                # NOTE: the DeepSeek account needs a positive balance (top up at platform.deepseek.com)
# Later: point the high-volume critic at a faster provider (e.g. Groq) for speed.
# AIDLC_CRITIC_BASE_URL=https://api.groq.com/openai/v1
# AIDLC_CRITIC_MODEL=llama-3.3-70b-versatile

# Alternative — Claude (managed; zero wiring, adapter defaults to ANTHROPIC_API_KEY)
# ANTHROPIC_API_KEY=
# AIDLC_MODEL= / AIDLC_CRITIC_MODEL=

# ─────────────────────────────────────────────────────────────────────────────
# 2) GITHUB APP  — register a standalone App, install on the target repo
#    Permissions (least-priv, already enforced in code): contents:write, pull_requests:write, metadata:read
# ─────────────────────────────────────────────────────────────────────────────
AIDLC_GITHUB_APP_ID=
AIDLC_GITHUB_APP_KEY_FILE=       # path to the App's .pem private key (preferred)
# AIDLC_GITHUB_APP_KEY=          # …or the PEM inline (use the _FILE form where you can)
AIDLC_GITHUB_INSTALL_ID=         # the installation id on your repo
# AIDLC_GITHUB_WEBHOOK_SECRET=   # needed later, when the Fastify webhook endpoint lands (Phase-1)

# Commits the agent authors:
AIDLC_GIT_AUTHOR_NAME=AIDLC Agent
AIDLC_GIT_AUTHOR_EMAIL=agent@aidlc.local

# ─────────────────────────────────────────────────────────────────────────────
# 3) SECRETS  — envelope master key (encrypts tenant secrets at rest)
#    Generate a 32-byte base64 key:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ─────────────────────────────────────────────────────────────────────────────
MASTER_KEK=

# ─────────────────────────────────────────────────────────────────────────────
# 4) DATABASE  — Postgres (used once the Phase-1 Drizzle+RLS store lands; in-mem store until then)
# ─────────────────────────────────────────────────────────────────────────────
# DATABASE_URL=postgres://aidlc:aidlc@localhost:5432/aidlc

# ─────────────────────────────────────────────────────────────────────────────
# Deferred for the first slice (keep unset)
# ─────────────────────────────────────────────────────────────────────────────
# E2B_API_KEY=                   # real Firecracker sandbox (the mock sandbox is fine for M0)
# STITCH_API_KEY= / STITCH_API_URL= / STITCH_MODEL_ID=   # UX stage (defer)
AIDLC_AUTO_MERGE=off             # keep OFF — honest gated deploy (holds at merge_confirmation)
